# Copy this file to .env and fill in the secrets before running automation scripts.

# OpenAI API key with access to GPT-4o or similar models.
OPENAI_API_KEY=sk-your-openai-api-key

# Repository configuration for the persona generator.
# Use the "owner/repo" format, e.g. rogeratncstate/user-journey-map-generator
GITHUB_REPO=your-org/your-repo
# Fine-grained personal access token with permissions to write to the repository.
GITHUB_TOKEN=ghp_your_token_here
# Optional: branch to target when uploading JSON files.
GITHUB_BRANCH=main
